<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Registered with SMAppService.agent(plistName:) – shows up in System Settings → General → Login Items. -->
    <key>Label</key><string>com.andremarques.kinetic.agent</string>
    <key>BundleProgram</key><string>Contents/Library/LoginItems/KineticAgent.app/Contents/MacOS/KineticAgent</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key><false/>
    </dict>
    <key>ProcessType</key><string>Interactive</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.andremarques.kinetic</string>
    </array>
</dict>
</plist>
